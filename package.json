{
  "name": "markdown-editor",
  "version": "0.1.0",
  "type": "module",
  "description": "Markdown editor for local files, hosted on Netlify",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@lucide/vue": "^1.70.0",
    "dompurify": "^3.4.17",
    "idb-keyval": "^6.3.0",
    "katex": "^0.18.10",
    "marked": "^18.1.3",
    "marked-katex-extension": "^5.1.13",
    "mathjax-full": "^3.2.2",
    "pdfmake": "^0.3.13",
    "unicodeit": "^0.7.5",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.5.1",
    "typescript": "~5.6.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.10"
  }
}
